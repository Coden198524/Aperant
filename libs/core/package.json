{
  "name": "@autocode/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Headless agent core for Autocode, shared across desktop, VS Code, and future UIs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tasks/cli-catalog": {
      "types": "./dist/tasks/cli-catalog.d.ts",
      "import": "./dist/tasks/cli-catalog.js",
      "default": "./dist/tasks/cli-catalog.js"
    },
    "./tasks/phase-protocol": {
      "types": "./dist/tasks/phase-protocol.d.ts",
      "import": "./dist/tasks/phase-protocol.js",
      "default": "./dist/tasks/phase-protocol.js"
    },
    "./tasks/progress": {
      "types": "./dist/tasks/progress.d.ts",
      "import": "./dist/tasks/progress.js",
      "default": "./dist/tasks/progress.js"
    },
    "./tasks/task-state-utils": {
      "types": "./dist/tasks/task-state-utils.d.ts",
      "import": "./dist/tasks/task-state-utils.js",
      "default": "./dist/tasks/task-state-utils.js"
    },
    "./tasks/task-status": {
      "types": "./dist/tasks/task-status.d.ts",
      "import": "./dist/tasks/task-status.js",
      "default": "./dist/tasks/task-status.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "check:boundaries": "node scripts/check-boundaries.cjs",
    "clean": "node scripts/clean-dist.cjs",
    "build": "npm run check:boundaries && tsc -p tsconfig.build.json",
    "ensure-built": "node scripts/ensure-built.cjs",
    "smoke": "npm run build && node scripts/smoke-test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "zod": "^4.3.6"
  }
}
