  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "check:boundaries": "node scripts/check-boundaries.cjs",
    "clean": "node scripts/clean-dist.cjs",
    "build": "npm run check:boundaries && tsc -p tsconfig.build.json",
    "ensure-built": "node scripts/ensure-built.cjs",
    "smoke": "npm run build && node scripts/smoke-test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "zod": "^4.3.6"
  }
